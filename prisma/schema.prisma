generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Workspace {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  name           String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  mappingPresets LifecycleMappingPreset[]
  presets        WorkspacePreset[]
  memberships    WorkspaceMembership[]
  datasets       WorkspaceDataset[]
}

model AccountUser {
  id          String                @id @default(cuid())
  email       String                @unique
  name        String
  passwordHash String?
  passwordSetAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships WorkspaceMembership[]
  datasets    WorkspaceDataset[]

  @@index([updatedAt])
}

model WorkspaceMembership {
  id            String      @id @default(cuid())
  workspaceId   String
  accountUserId String
  role          String      @default("owner")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountUser   AccountUser @relation(fields: [accountUserId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, accountUserId])
  @@index([accountUserId, updatedAt])
  @@index([workspaceId, role])
}

model WorkspaceDataset {
  id            String       @id @default(cuid())
  workspaceId   String
  accountUserId String?
  app           String
  sourceType    String
  name          String
  status        String       @default("imported")
  rowData       Json
  rowCounts     Json
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountUser   AccountUser? @relation(fields: [accountUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, app, createdAt])
  @@index([accountUserId, createdAt])
  @@index([app, status, createdAt])
}

enum UserSegment {
  FREE
  TRIAL
  LAPSED
  ACTIVE
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  CANCELED
  EXPIRED
}

enum DeltaChangeType {
  ADDRESS_CHANGE
  PHONE_ADDED
  PHONE_CHANGED
  EMAIL_ADDED
  ASSOCIATE_ADDED
  LEGAL_RECORD_ADDED
}

enum CampaignStatus {
  PENDING
  GENERATED
  REVIEWED
  APPROVED
  REJECTED
}

enum AcquisitionChannel {
  SEARCH
  SOCIAL
  DISPLAY
  VIDEO
}

enum AcquisitionCampaignState {
  DRAFT
  TESTING
  SCALING
  PAUSED
  COMPLETED
}

model AcquisitionCampaign {
  id                String                   @id @default(cuid())
  name              String
  objective         String
  budgetCents       Int
  startAt           DateTime
  endAt             DateTime
  channels          AcquisitionChannel[]
  maxBudgetShiftPct Float                    @default(0.2)
  minConfidence     Float                    @default(0.65)
  cooldownHours     Int                      @default(24)
  targetCacCents    Int
  targetLtvCents    Int
  cacAutoPausePctOfTarget Float              @default(1.25)
  minLtvCacRatio    Float                    @default(2.5)
  approvalCapPct    Float                    @default(0.15)
  state             AcquisitionCampaignState @default(DRAFT)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  creatives         AdCreative[]
  audiences         AudienceSegment[]
  testCells         TestCell[]
  budgetActivities  BudgetActivity[]
  auditLogs         AcquisitionAuditLog[]

  @@index([state, updatedAt])
  @@index([startAt, endAt])
}

model AdCreative {
  id                  String              @id @default(cuid())
  campaignId          String
  headline            String
  description         String
  callToAction        String
  channel             AcquisitionChannel
  predictedCtr        Float
  predictedConversion Float
  status              CampaignStatus      @default(PENDING)
  createdAt           DateTime            @default(now())
  campaign            AcquisitionCampaign @relation(fields: [campaignId], references: [id])
  testCells           TestCell[]

  @@index([campaignId, status])
  @@index([campaignId, channel])
}

model AudienceSegment {
  id                String              @id @default(cuid())
  campaignId        String
  templateId        String?
  name              String
  audienceType      String
  targetingJson     Json
  predictedCpcCents Int
  predictedCacCents Int
  createdAt         DateTime            @default(now())
  campaign          AcquisitionCampaign @relation(fields: [campaignId], references: [id])
  template          AudienceTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  testCells         TestCell[]

  @@index([campaignId, audienceType])
  @@index([campaignId, createdAt])
  @@index([templateId])
}

model AuctionAdvertiser {
  id                String                    @id @default(cuid())
  name              String
  qualityScore      Float
  dailyBudgetCents  Int
  smoothingFactor   Float                     @default(0.5)
  behaviorMode      String                    @default("truthful")
  targetCacCents    Int?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  bids              AuctionBid[]
  results           AuctionResultRow[]
  spends            AuctionAdvertiserSpend[]

  @@index([behaviorMode])
}

model AuctionSlot {
  id                  String          @id @default(cuid())
  name                String
  reservePriceCents   Int
  expectedDailyVolume Int             @default(100)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  bids                AuctionBid[]
  results             AuctionResult[]

  @@index([createdAt])
}

model AuctionBid {
  id           String            @id @default(cuid())
  advertiserId String
  slotId       String
  bidCents     Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  advertiser   AuctionAdvertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  slot         AuctionSlot       @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([advertiserId, slotId])
  @@index([slotId])
}

model AuctionRun {
  id                   String                   @id @default(cuid())
  totalAuctions        Int
  totalRevenueCents    Int
  fillRate             Float
  fillQuality          Float
  revenueStability     Float
  bidderTrustProxy     Float
  notes                String?
  createdAt            DateTime                 @default(now())
  results              AuctionResult[]
  spendSnapshots       AuctionAdvertiserSpend[]
  auditLogs            AuctionAuditLog[]

  @@index([createdAt])
}

model AuctionResult {
  id                 String             @id @default(cuid())
  runId              String
  slotId             String
  iterationIndex     Int
  filled             Boolean
  winnerAdvertiserId String?
  clearingPriceCents Int?
  reservePriceCents  Int
  createdAt          DateTime           @default(now())
  run                AuctionRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  slot               AuctionSlot        @relation(fields: [slotId], references: [id])
  rankedBids         AuctionResultRow[]

  @@index([runId, iterationIndex])
  @@index([slotId, createdAt])
}

model AuctionResultRow {
  id                  String            @id @default(cuid())
  resultId            String
  advertiserId        String
  bidCents            Int
  effectiveBidCents   Int
  qualityScore        Float
  adjustedScore       Float
  eligible            Boolean
  ineligibilityReason String?
  rank                Int
  result              AuctionResult     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  advertiser          AuctionAdvertiser @relation(fields: [advertiserId], references: [id])

  @@index([resultId, rank])
}

model AuctionAdvertiserSpend {
  id                   String            @id @default(cuid())
  runId                String
  advertiserId         String
  totalSpendCents      Int
  totalWins            Int
  averageClearingCents Int
  fillShare            Float
  run                  AuctionRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  advertiser           AuctionAdvertiser @relation(fields: [advertiserId], references: [id])

  @@unique([runId, advertiserId])
  @@index([advertiserId])
}

model AuctionAuditLog {
  id        String      @id @default(cuid())
  runId     String?
  actor     String
  action    String
  metadata  Json
  createdAt DateTime    @default(now())
  run       AuctionRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([action, createdAt])
}

model PricingSegment {
  id                     String                     @id @default(cuid())
  name                   String
  eligibilityRule        String
  baselineConversionRate Float
  baselineChurnRate      Float
  baselineArpuCents      Int
  grossMarginPercent     Float
  monthlyVolume          Int
  riskBand               String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  experimentSegments     PricingExperimentSegment[]
  segmentResults         PricingSegmentResult[]

  @@index([riskBand])
}

model PricingVariant {
  id                       String                     @id @default(cuid())
  name                     String
  monthlyPriceCents        Int
  annualPriceCents         Int?
  packagingChange          String
  marginImpactPercent      Float
  expectedSupportLoadDelta Float
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  experimentVariants       PricingExperimentVariant[]
  segmentResults           PricingSegmentResult[]
}

model PricingExperiment {
  id                    String                     @id @default(cuid())
  name                  String
  hypothesis            String
  owner                 String
  state                 String                     @default("DRAFT")
  holdoutPercent        Float
  minimumSampleSize     Int
  minGrossMarginPercent Float
  maxChurnDeltaPercent  Float
  maxSupportLoadDelta   Float
  minConfidence         Float
  startedAt             DateTime?
  decisionDueAt         DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  segments              PricingExperimentSegment[]
  variants              PricingExperimentVariant[]
  runs                  PricingExperimentRun[]
  decisions             PricingDecision[]
  auditLogs             PricingAuditLog[]

  @@index([state, createdAt])
}

model PricingExperimentSegment {
  id           String            @id @default(cuid())
  experimentId String
  segmentId    String
  experiment   PricingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  segment      PricingSegment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, segmentId])
  @@index([segmentId])
}

model PricingExperimentVariant {
  id           String            @id @default(cuid())
  experimentId String
  variantId    String
  role         String
  experiment   PricingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      PricingVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, variantId])
  @@index([variantId])
}

model PricingExperimentRun {
  id                     String                 @id @default(cuid())
  experimentId            String
  arpuLiftPercent         Float
  conversionDeltaPercent  Float
  churnDeltaPercent       Float
  grossMarginPercent      Float
  netRevenueLiftCents     Int
  supportLoadDelta        Float
  confidence              Float
  holdoutHealth           String
  recommendation          String
  createdAt               DateTime               @default(now())
  experiment              PricingExperiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  segmentResults          PricingSegmentResult[]

  @@index([experimentId, createdAt])
  @@index([recommendation, createdAt])
}

model PricingSegmentResult {
  id                    String               @id @default(cuid())
  runId                 String
  segmentId             String
  variantId             String
  sampleSize            Int
  conversionRate        Float
  churnRate             Float
  arpuCents             Int
  grossMarginPercent    Float
  netRevenueLiftCents   Int
  guardrailBand         String
  run                   PricingExperimentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  segment               PricingSegment       @relation(fields: [segmentId], references: [id])
  variant               PricingVariant       @relation(fields: [variantId], references: [id])

  @@index([runId])
  @@index([segmentId])
  @@index([variantId])
}

model PricingDecision {
  id           String            @id @default(cuid())
  experimentId String
  decision     String
  rationale    String
  actor        String
  createdAt    DateTime          @default(now())
  experiment   PricingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, createdAt])
  @@index([decision, createdAt])
}

model PricingAuditLog {
  id           String             @id @default(cuid())
  experimentId String?
  action       String
  actor        String
  detail       String
  metadata     Json?
  createdAt    DateTime           @default(now())
  experiment   PricingExperiment? @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, createdAt])
  @@index([action, createdAt])
}

model RetentionAccount {
  id                 String                  @id @default(cuid())
  name               String
  segment            String
  mrrCents           Int
  usageScore         Float
  supportTicketCount Int
  npsScore           Int
  renewalDays        Int
  paymentRiskScore   Float
  executiveSponsor   Boolean                 @default(false)
  lastTouchedDays    Int
  healthTrend        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  runRows            RetentionRiskRunRow[]
  interventions      RetentionIntervention[]

  @@index([segment])
  @@index([renewalDays])
}

model RetentionPlaybook {
  id             String                  @id @default(cuid())
  name           String
  riskDriver     String
  saveRateLift   Float
  costCents      Int
  maxDiscountPct Float
  slaHours       Int
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  runRows        RetentionRiskRunRow[]
  interventions  RetentionIntervention[]

  @@index([riskDriver])
}

model RetentionPolicy {
  id                  String             @id @default(cuid())
  name                String
  highRiskThreshold   Float
  mediumRiskThreshold Float
  maxDiscountPct      Float
  minPaybackRatio     Float
  slaHoursHighRisk    Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  runs                RetentionRiskRun[]
}

model RetentionRiskRun {
  id                         String                @id @default(cuid())
  policyId                   String
  averageRiskScore           Float
  highRiskAccounts           Int
  preventableChurnCents      Int
  expectedSavedRevenueCents  Int
  saveRate                   Float
  paybackRatio               Float
  recommendation             String
  createdAt                  DateTime              @default(now())
  policy                     RetentionPolicy       @relation(fields: [policyId], references: [id])
  rows                       RetentionRiskRunRow[]
  auditLogs                  RetentionAuditLog[]

  @@index([policyId, createdAt])
  @@index([recommendation, createdAt])
}

model RetentionRiskRunRow {
  id                         String             @id @default(cuid())
  runId                      String
  accountId                  String
  playbookId                 String?
  riskScore                  Float
  riskBand                   String
  primaryDriver              String
  expectedSavedRevenueCents  Int
  interventionCostCents      Int
  paybackRatio               Float
  slaHours                   Int
  run                        RetentionRiskRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  account                    RetentionAccount   @relation(fields: [accountId], references: [id])
  playbook                   RetentionPlaybook? @relation(fields: [playbookId], references: [id])

  @@index([runId])
  @@index([accountId])
  @@index([playbookId])
  @@index([riskBand, riskScore])
}

model RetentionIntervention {
  id                String               @id @default(cuid())
  accountId         String
  playbookId        String
  status            String               @default("queued")
  owner             String
  rationale         String
  dueAt             DateTime?
  savedRevenueCents Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  account           RetentionAccount     @relation(fields: [accountId], references: [id])
  playbook          RetentionPlaybook    @relation(fields: [playbookId], references: [id])
  auditLogs         RetentionAuditLog[]

  @@index([accountId, createdAt])
  @@index([playbookId])
  @@index([status, createdAt])
}

model RetentionAuditLog {
  id             String                 @id @default(cuid())
  runId          String?
  interventionId String?
  actor          String
  action         String
  detail         String
  metadata       Json?
  createdAt      DateTime               @default(now())
  run            RetentionRiskRun?      @relation(fields: [runId], references: [id], onDelete: Cascade)
  intervention   RetentionIntervention? @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([interventionId, createdAt])
  @@index([action, createdAt])
}

model ExpansionAccount {
  id                   String                    @id @default(cuid())
  name                 String
  segment              String
  currentArrCents      Int
  seatsPurchased       Int
  seatsActive          Int
  usageGrowthRate      Float
  productQualifiedScore Float
  supportHealthScore   Float
  renewalDays          Int
  executiveSponsor     Boolean                   @default(false)
  openExpansionSignals Int
  trend                String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  runRows              ExpansionRunRow[]

  @@index([segment])
  @@index([renewalDays])
}

model ExpansionOffer {
  id                  String            @id @default(cuid())
  name                String
  motion              String
  targetSegment       String
  expectedLiftPercent Float
  costCents           Int
  marginPercent       Float
  slaDays             Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  runRows             ExpansionRunRow[]

  @@index([motion])
  @@index([targetSegment])
}

model ExpansionPolicy {
  id                       String         @id @default(cuid())
  name                     String
  highReadinessThreshold   Float
  mediumReadinessThreshold Float
  minMarginPercent         Float
  minPaybackRatio          Float
  maxSlaDays               Int
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  runs                     ExpansionRun[]
}

model ExpansionRun {
  id                        String             @id @default(cuid())
  policyId                  String
  averageReadinessScore     Float
  highReadinessAccounts     Int
  pipelineArrCents          Int
  expectedExpansionArrCents Int
  averageMarginPercent      Float
  paybackRatio              Float
  recommendation            String
  createdAt                 DateTime           @default(now())
  policy                    ExpansionPolicy    @relation(fields: [policyId], references: [id])
  rows                      ExpansionRunRow[]
  auditLogs                 ExpansionAuditLog[]

  @@index([policyId, createdAt])
  @@index([recommendation, createdAt])
}

model ExpansionRunRow {
  id                        String           @id @default(cuid())
  runId                     String
  accountId                 String
  offerId                   String?
  readinessScore            Float
  readinessBand             String
  primaryMotion             String
  expectedExpansionArrCents Int
  pursuitCostCents          Int
  paybackRatio              Float
  marginPercent             Float
  slaDays                   Int
  decision                  String
  run                       ExpansionRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  account                   ExpansionAccount @relation(fields: [accountId], references: [id])
  offer                     ExpansionOffer?  @relation(fields: [offerId], references: [id])

  @@index([runId])
  @@index([accountId])
  @@index([offerId])
  @@index([readinessBand, readinessScore])
  @@index([decision])
}

model ExpansionAuditLog {
  id        String        @id @default(cuid())
  runId     String?
  actor     String
  action    String
  detail    String
  metadata  Json?
  createdAt DateTime      @default(now())
  run       ExpansionRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([action, createdAt])
}

model AdAccountConnection {
  id                  String   @id @default(cuid())
  provider            String
  externalAccountId   String
  accountName         String
  isTestAccount       Boolean  @default(true)
  scopes              String[]
  encryptedAccessToken String
  encryptedRefreshToken String?
  expiresAt           DateTime?
  lastFetchedAt       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([provider, externalAccountId])
  @@index([provider])
  @@index([createdAt])
}

model AudienceTemplate {
  id                String            @id @default(cuid())
  name              String
  audienceType      String
  targetingJson     Json
  predictedCpcCents Int
  predictedCacCents Int
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  segments          AudienceSegment[]

  @@index([audienceType])
  @@index([createdAt])
}

model TestCell {
  id              String              @id @default(cuid())
  campaignId      String
  creativeId      String
  audienceId      String
  budgetCents     Int
  impressions     Int                 @default(0)
  clicks          Int                 @default(0)
  conversions     Int                 @default(0)
  spendCents      Int                 @default(0)
  revenueCents    Int                 @default(0)
  cacCents        Int                 @default(0)
  roas            Float               @default(0)
  score           Float               @default(0)
  status          CampaignStatus      @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  campaign        AcquisitionCampaign @relation(fields: [campaignId], references: [id])
  creative        AdCreative          @relation(fields: [creativeId], references: [id])
  audience        AudienceSegment     @relation(fields: [audienceId], references: [id])
  performances    AdPerformance[]
  budgetMovesFrom BudgetActivity[]    @relation("BudgetMoveFrom")
  budgetMovesTo   BudgetActivity[]    @relation("BudgetMoveTo")

  @@unique([campaignId, creativeId, audienceId])
  @@index([campaignId, score])
  @@index([campaignId, status])
}

model AdPerformance {
  id             String   @id @default(cuid())
  testCellId     String
  recordedAt     DateTime @default(now())
  impressions    Int
  clicks         Int
  conversions    Int
  spendCents     Int
  revenueCents   Int
  ctr            Float
  conversionRate Float
  cpcCents       Int
  cpaCents       Int
  roas           Float
  testCell       TestCell @relation(fields: [testCellId], references: [id])

  @@index([testCellId, recordedAt])
}

model BudgetActivity {
  id             String              @id @default(cuid())
  campaignId     String
  fromTestCellId String?
  toTestCellId   String?
  amountCents    Int
  reason         String
  createdAt      DateTime            @default(now())
  campaign       AcquisitionCampaign @relation(fields: [campaignId], references: [id])
  fromTestCell   TestCell?           @relation("BudgetMoveFrom", fields: [fromTestCellId], references: [id])
  toTestCell     TestCell?           @relation("BudgetMoveTo", fields: [toTestCellId], references: [id])

  @@index([campaignId, createdAt])
  @@index([fromTestCellId])
  @@index([toTestCellId])
}

model AcquisitionAuditLog {
  id         String              @id @default(cuid())
  campaignId String
  actor      String
  action     String
  metadata   Json
  createdAt  DateTime            @default(now())
  campaign   AcquisitionCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId, createdAt])
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  segment            UserSegment
  subscriptionStatus SubscriptionStatus
  lastActiveAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  interestEdges      InterestEdge[]
  campaignCandidates CampaignCandidate[]
}

model Entity {
  id                 String              @id @default(cuid())
  name               String
  entityType         String
  city               String?
  state              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deltas             EntityDelta[]
  interestEdges      InterestEdge[]
  campaignCandidates CampaignCandidate[]
}

model EntityDelta {
  id                 String              @id @default(cuid())
  entityId           String
  changeType         DeltaChangeType
  oldValue           String?
  newValue           String?
  deltaSummary       String
  detectedAt         DateTime
  createdAt          DateTime            @default(now())
  entity             Entity              @relation(fields: [entityId], references: [id])
  campaignCandidates CampaignCandidate[]
}

model InterestEdge {
  id            String   @id @default(cuid())
  userId        String
  entityId      String
  interestScore Float
  source        String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  entity        Entity   @relation(fields: [entityId], references: [id])

  @@unique([userId, entityId, source])
}

model CampaignCandidate {
  id                     String            @id @default(cuid())
  campaignRunId          String?
  userId                 String
  entityId               String
  entityDeltaId          String
  segmentAtGeneration    UserSegment
  priorityScore          Float
  interestContribution   Float             @default(0)
  recencyContribution    Float             @default(0)
  segmentContribution    Float             @default(0)
  changeTypeContribution Float             @default(0)
  status                 CampaignStatus    @default(PENDING)
  createdAt              DateTime          @default(now())
  campaignRun            CampaignRun?      @relation(fields: [campaignRunId], references: [id])
  user                   User              @relation(fields: [userId], references: [id])
  entity                 Entity            @relation(fields: [entityId], references: [id])
  entityDelta            EntityDelta       @relation(fields: [entityDeltaId], references: [id])
  generatedMessage       GeneratedMessage?
}

model GeneratedMessage {
  id                  String            @id @default(cuid())
  campaignCandidateId String            @unique
  subjectLine         String
  previewText         String
  emailBody           String
  landingHeadline     String
  landingBody         String
  ctaText             String
  modelName           String
  createdAt           DateTime          @default(now())
  campaignCandidate   CampaignCandidate @relation(fields: [campaignCandidateId], references: [id])
}

model CampaignRun {
  id                      String              @id @default(cuid())
  runName                 String
  assumptionSetId         String?
  assumptionsSnapshot     Json
  totalDeltas             Int
  totalMatches            Int
  totalHighPriority       Int
  estimatedOpenRate       Float
  estimatedCtr            Float
  estimatedConversionRate Float
  estimatedRevenue        Float
  createdAt               DateTime            @default(now())
  assumptionSet           AssumptionSet?      @relation(fields: [assumptionSetId], references: [id])
  candidates              CampaignCandidate[]
}

model AssumptionSet {
  id                     String        @id @default(cuid())
  name                   String
  isActive               Boolean       @default(false)
  defaultTopN            Int           @default(50)
  recencyScore           Float         @default(0.9)
  minPriorityScore       Float         @default(0)
  highPriorityThreshold  Float         @default(0.65)
  highPriorityLift       Float         @default(1.8)
  openRate               Float         @default(0.5)
  clickRate              Float         @default(0.24)
  engageRate             Float         @default(0.45)
  purchaseRate           Float         @default(0.25)
  avgOrderValue          Float         @default(129)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  campaignRuns           CampaignRun[]
}

model LifecycleImportLog {
  id                    String   @id @default(cuid())
  sourceType            String
  sourceName            String
  status                String
  usersImported         Int      @default(0)
  entitiesImported      Int      @default(0)
  interestEdgesImported Int      @default(0)
  changeEventsImported  Int      @default(0)
  validationErrors      Int      @default(0)
  metadata              Json?
  createdAt             DateTime @default(now())

  @@index([sourceType, createdAt])
  @@index([status, createdAt])
}

model LifecycleMappingPreset {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  sourceType  String
  app         String
  mappings    Json
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, app, sourceType, updatedAt])
  @@unique([workspaceId, app, sourceType, name])
}

model WorkspacePreset {
  id          String    @id @default(cuid())
  workspaceId String
  app         String
  presetType  String
  name        String
  values      Json
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, app, presetType, updatedAt])
  @@unique([workspaceId, app, presetType, name])
}
